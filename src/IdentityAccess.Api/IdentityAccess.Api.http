@baseUrl = http://127.0.0.1:5080

GET {{baseUrl}}/health/live
Accept: application/json

###
GET {{baseUrl}}/health/ready
Accept: application/json

###
GET {{baseUrl}}/api/v1/system/info
Accept: application/json

###
GET {{baseUrl}}/swagger/v1/swagger.json
Accept: application/json

### Password login (requires Authentication.Enabled=true and a registered client)
POST {{IdentityAccess_ApiHostAddress}}/api/v1/authentication/clients/web-client/password-login
Content-Type: application/json

{
  "loginIdentifier": "user@example.test",
  "password": "replace-with-a-test-password",
  "redirectUri": "http://127.0.0.1:3000/auth/callback"
}
