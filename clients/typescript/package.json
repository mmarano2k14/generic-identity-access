{
  "name": "@identity-access/client",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Class-based TypeScript connector with authentication, OIDC/PKCE, authorization, typed administration, and hardened Next.js admin UI composition.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepack": "npm run build",
    "smoke": "npm run build && node test/smoke-api.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
