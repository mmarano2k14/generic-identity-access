{
  "name": "@generic-identity/react",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Reusable React providers, authorization gates, shared Identity pages, theming and visual override contracts.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./authorization": {
      "types": "./src/authorization/index.ts",
      "import": "./src/authorization/index.ts",
      "default": "./src/authorization/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./src/providers/index.ts",
      "default": "./src/providers/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./pages": {
      "types": "./src/pages/index.ts",
      "import": "./src/pages/index.ts",
      "default": "./src/pages/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./visual": {
      "types": "./src/visual/index.ts",
      "import": "./src/visual/index.ts",
      "default": "./src/visual/index.ts"
    },
    "./theme.css": "./src/theme/default.css",
    "./account": {
      "types": "./src/account/index.ts",
      "import": "./src/account/index.ts",
      "default": "./src/account/index.ts"
    },
    "./directory": {
      "types": "./src/directory/index.ts",
      "import": "./src/directory/index.ts",
      "default": "./src/directory/index.ts"
    },
    "./organizations": {
      "types": "./src/organizations/index.ts",
      "import": "./src/organizations/index.ts",
      "default": "./src/organizations/index.ts"
    },
    "./access-control": {
      "types": "./src/access-control/index.ts",
      "import": "./src/access-control/index.ts",
      "default": "./src/access-control/index.ts"
    },
    "./application-security": {
      "types": "./src/application-security/index.ts",
      "import": "./src/application-security/index.ts",
      "default": "./src/application-security/index.ts"
    },
    "./security-operations": {
      "types": "./src/security-operations/index.ts",
      "import": "./src/security-operations/index.ts",
      "default": "./src/security-operations/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@generic-identity/auth": "file:../auth",
    "@generic-identity/contracts": "file:../contracts"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
